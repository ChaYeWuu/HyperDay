<?xml version="1.0" encoding="utf-8"?>
<!-- One week row of the 🦌🦌记录器 month widget: 7 identical cells, each an
     ImageView whose drawable the provider switches per day state
     (none / 破戒 / 今天). Ids repeat across rows on purpose — every row is its
     own RemoteViews instance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/deer_cell_0"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:src="@drawable/widget_deer_day_none" />

    <ImageView
        android:id="@+id/deer_cell_1"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:src="@drawable/widget_deer_day_none" />

    <ImageView
        android:id="@+id/deer_cell_2"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:src="@drawable/widget_deer_day_none" />

    <ImageView
        android:id="@+id/deer_cell_3"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:src="@drawable/widget_deer_day_none" />

    <ImageView
        android:id="@+id/deer_cell_4"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:src="@drawable/widget_deer_day_none" />

    <ImageView
        android:id="@+id/deer_cell_5"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:src="@drawable/widget_deer_day_none" />

    <ImageView
        android:id="@+id/deer_cell_6"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_margin="1dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:src="@drawable/widget_deer_day_none" />
</LinearLayout>
