<?xml version="1.0" encoding="utf-8"?>
<!-- Events list widget (4x2, resizable). Rows are injected in code; each
      row carries its own 距离/过去 tag pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- RemoteViews only whitelists specific view classes: Space is not
         allowed and makes the host fail to inflate. Weighted empty
         TextView is the standard flexible spacer. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="" />
</LinearLayout>
