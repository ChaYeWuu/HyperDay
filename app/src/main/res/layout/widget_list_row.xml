<?xml version="1.0" encoding="utf-8"?>
<!-- One event row inside the list widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/widget_row_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_tag_bg"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/widget_text_primary"
        android:textSize="15sp" />

    <!-- Fixed-width date column with zero-padded uniform dates: leading year
         digits align across rows (2026 lines up with 2027). Wide enough for
         "2026年09月05日" (8 digits + 3 CJK at 12sp) without ellipsizing. -->
    <TextView
        android:id="@+id/widget_row_date"
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="none"
        android:gravity="start"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <!-- Fixed-width, right-aligned day column: 天对齐天 across rows. -->
    <TextView
        android:id="@+id/widget_row_days"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif"
        android:gravity="end"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="@color/widget_accent"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_row_days_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:text="天"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
